# iOS simulator can reach localhost directly. Android emulator needs http://10.0.2.2:8080.
# A physical device needs your machine's LAN IP (e.g. http://192.168.1.23:8080).

# Expo Go (own iphone)
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8080

# Iphone simulator
EXPO_PUBLIC_API_URL=http://localhost:8080

# Android simulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
