<?xml version="1.0" encoding="UTF-8"?>
<!-- The logs table appender is added in code (DatabaseLogging) once the database is ready. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <logger name="com.myplunt.audit" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Untrusted, so only in the logs table. -->
    <logger name="com.myplunt.frontend" level="INFO" additivity="false"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
