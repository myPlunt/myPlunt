<?xml version="1.0" encoding="UTF-8"?>
<!-- The console keeps Spring Boot's readable format and shows everything but the app's lines.
     The structured lines (backend, audit and the app's) go to the logs table, hooked up by
     DatabaseLogging once the app is ready. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <logger name="com.myplunt.audit" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Untrusted, so only in the logs table. -->
    <logger name="com.myplunt.frontend" level="INFO" additivity="false"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
